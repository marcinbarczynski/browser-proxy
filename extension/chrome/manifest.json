{
  "manifest_version": 3,
  "name": "Browser Proxy",
  "version": "1.0.3",
  "description": "Routes in-browser link clicks through the browser-proxy daemon, redirecting to the configured browser when rules match.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Browser Proxy",
    "default_popup": "popup.html"
  }
}
